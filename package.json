{
  "name": "@vanloenenconsultancy/vue-pdf-embed",
  "version": "2.4.0",
  "description": "PDF embed component for Vue",
  "keywords": [
    "vue",
    "vuejs",
    "pdf"
  ],
  "license": "MIT",
  "author": "Aliaksei Hrynko (https://github.com/hrynko)",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.umd.js",
      "types": "./dist/types/index.d.ts"
    },
    "./dist/index.essential.mjs": {
      "import": "./dist/index.essential.mjs",
      "types": "./dist/types/index.essential.d.ts"
    },
    "./dist/styles/": "./dist/styles/"
  },
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "husky && npm run build",
    "dev": "vite -c vite.config.dev.ts",
    "build": "vite build && vite build -c vite.config.essential.ts --emptyOutDir false",
    "test": "vitest",
    "lint": "eslint . --fix",
    "format": "prettier . --write --ignore-unknown"
  },
  "dependencies": {
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.3",
    "@types/clean-css": "^4.2.11",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "clean-css": "^5.3.3",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.8.0",
    "happy-dom": "^15.7.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "rollup-plugin-copy": "^3.5.0",
    "sass": "^1.94.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "vue": "^3.5.24",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.3",
    "vue-spinner": "^1.0.4",
    "cssnano": "^7.1.2",
    "postcss": "^8.5.6",
    "postcss-selector-parser": "^7.1.1"
  },
  "peerDependencies": {
    "vue": "^3.5.22"
  },
  "resolutions": {
    "vite": "^7.2.2"
  }
}
